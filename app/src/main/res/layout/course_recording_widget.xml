<?xml version="1.0" encoding="utf-8"?>
<!-- Single-row widget: [rec] title+timer [stop] [refresh] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.AudioRecorder.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <ImageButton
        android:id="@+id/btn_course_record"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/course_widget_record"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@mipmap/audio_recorder_widget_button" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_course_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/course_widget_no_event"
            android:textColor="#212121"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_recording_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/course_widget_idle"
            android:textColor="#0D9488"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_course_stop"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/course_widget_stop"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_stop" />

    <ImageButton
        android:id="@+id/btn_course_refresh"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/course_widget_refresh"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_refresh" />
</LinearLayout>
