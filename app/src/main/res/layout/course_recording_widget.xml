<?xml version="1.0" encoding="utf-8"?>
<!--
  logo [open app] | title+timer [open app] | [Stop/REC] [Refresh]
  Lucide icons, day/night colors via drawable / drawable-night.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.AudioRecorder.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <ImageButton
        android:id="@+id/btn_course_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/course_widget_open_app"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_mic_signal" />

    <LinearLayout
        android:id="@+id/area_course_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_course_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/course_widget_no_event"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_recording_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/course_widget_idle"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_course_rec_stop"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/course_widget_record"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_mic" />

    <ImageButton
        android:id="@+id/btn_course_refresh"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/course_widget_refresh"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_refresh" />
</LinearLayout>
